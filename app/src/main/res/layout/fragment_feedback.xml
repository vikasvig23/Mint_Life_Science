<?xml version="1.0" encoding="utf-8"?>

<layout>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="600dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/corners"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        >

        <TextView
            android:id="@+id/feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Give Feedback"
            android:textSize="25dp"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingBottom="5dp"
            android:background="@drawable/corner_back"
            />

        <TextView
            android:id="@+id/schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule Meet Again"
            android:textSize="18dp"
            app:layout_constraintTop_toBottomOf="@+id/feedback"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="25dp"
            android:layout_marginTop="45dp"/>

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/feedback"
            android:text="Select Date"
            android:textSize="18dp"
            android:textColor="@color/white"
            android:layout_marginTop="38dp"
            android:paddingStart="29dp"
            android:paddingEnd="25dp"
            android:paddingTop="5dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toEndOf="@+id/schedule"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingBottom="5dp"
            android:background="@drawable/corner_back"
            
            />

        <TextView
            android:id="@+id/dd"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@drawable/date_block"
            android:hint="dd"
            android:textAlignment="center"
            android:textSize="18dp"
            app:layout_constraintTop_toBottomOf="@+id/schedule"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="36dp"
            android:padding="22dp"/>

        <TextView
            android:id="@+id/mm"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@drawable/date_block"
            android:hint="mm"
            android:textAlignment="center"
            android:textSize="18dp"
            app:layout_constraintTop_toBottomOf="@+id/schedule"
            app:layout_constraintStart_toEndOf="@+id/dd"
            android:layout_marginTop="24dp"
            android:layout_marginStart="37dp"
            android:padding="22dp"/>

        <TextView
            android:id="@+id/yy"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@drawable/date_block"
            android:hint="yyyy"
            android:textSize="18dp"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@+id/schedule"
            app:layout_constraintStart_toEndOf="@+id/mm"
            android:layout_marginTop="24dp"
            android:layout_marginStart="37dp"
            android:padding="22dp"/>

        <EditText
            android:id="@+id/response"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/date_block"
            android:hint="Give Your Feedback here"
            android:textSize="18dp"

            app:layout_constraintTop_toBottomOf="@+id/mm"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="24dp"
            android:padding="22dp"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/response"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="SUBMIT"
            android:backgroundTint="#5367E5"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:textSize="18dp"/>



    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>